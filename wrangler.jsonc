{
	"$schema"            : "node_modules/wrangler/config-schema.json",
	"name"               : "homebrewery",
	"main"               : "worker/index.js",
	"compatibility_date" : "2026-10-01",

	// Builds the client bundle into ./build before every `wrangler dev` / `wrangler deploy`;
	// `wrangler dev` rebuilds when the client sources change
	"build" : {
		"command"   : "npm run build",
		"watch_dir" : ["client", "shared", "themes/V3", "themes/Legacy", "index.html"]
	},

	// Static client assets. Requests matching a file in ./build are served without invoking
	// the Worker. html_handling "none" keeps "/" from resolving to build/index.html, so page
	// routes reach the Worker, which injects the page props into that HTML.
	"assets" : {
		"directory"     : "./build",
		"binding"       : "ASSETS",
		"html_handling" : "none"
	},

	// Page markdown and schema migrations are bundled into the Worker as text modules
	"rules" : [
		{ "type": "Text", "globs": ["**/*.md", "**/*.sql"], "fallthrough": true }
	],

	"vars" : {
		"ENVIRONMENT" : "production"
	},

	// Both databases are in the EU jurisdiction: they only run and store data inside the EU.
	// The Worker applies pending migrations itself (server/storage/migrate.js)
	"d1_databases" : [
		{ "binding": "DB", "database_name": "homebrewery", "database_id": "a81f2dea-f09c-402a-96db-e5f8632a274e", "migrations_dir": "migrations" }
	],

	// Live share-page updates (worker/brewUpdates.js)
	"durable_objects" : {
		"bindings" : [
			{ "name": "BREW_UPDATES", "class_name": "BrewUpdates" }
		]
	},
	"migrations" : [
		{ "tag": "v1", "new_sqlite_classes": ["BrewUpdates"] }
	],

	// Branch builds (`wrangler preview`) get their own database, so previews never touch production data
	"previews" : {
		"vars" : {
			"ENVIRONMENT" : "preview"
		},
		"d1_databases" : [
			{ "binding": "DB", "database_name": "homebrewery-preview", "database_id": "9ee6a3d8-6c9e-43a2-8c55-3faf6b93b653", "migrations_dir": "migrations" }
		],
		"durable_objects" : {
			"bindings" : [
				{ "name": "BREW_UPDATES", "class_name": "BrewUpdates" }
			]
		}
	},

	"workers_dev"   : true,
	"preview_urls"  : true,
	"observability" : {
		"enabled" : true
	}
}
